# 应用运行账号：只授予业务表和 app_runtime.events 的最小权限
DATABASE_URL=postgres://yunling_app:change-me@127.0.0.1:5432/yunling
# 迁移/重置/安全检查使用数据库属主或迁移账号
MIGRATE_DATABASE_URL=postgres://yunling:change-me@127.0.0.1:5432/yunling
JWT_SECRET=replace-with-at-least-32-random-bytes
DATA_ENCRYPTION_KEY=replace-with-a-random-secret
ENABLE_DEV_LOGIN=true
PORT=3000
NODE_ENV=development

# 生产环境必须显式设置 JWT_SECRET、DATA_ENCRYPTION_KEY 和 DATABASE_URL。
