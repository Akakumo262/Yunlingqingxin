# 复制为 backend/.env 使用。端口约定见 docs/前后端对齐契约.md，不要随意改。
PORT=3000
JWT_SECRET=dev-only-secret-change-me
# DATABASE_URL=postgres://yunling_app:yunling_app@localhost:5432/yunling
# MIGRATE_DATABASE_URL=postgres://yunling:yunling@localhost:5432/yunling
# REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:5173,http://localhost:10086
ENABLE_DEV_LOGIN=true
# 字段加密主密钥（32 字节，base64）。不得入库
# FIELD_ENCRYPTION_KEY=
# AI：只允许国产模型。不配置时使用本地检索式回答
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# 微信小程序：不配置时 /auth/wechat/login 走开发桩
# WECHAT_APPID=
# WECHAT_SECRET=

# ── 前端（可选）──
# Web：frontend/web/.env.local 里写 VITE_API_MODE=auto|http|mock
# 小程序：启动前设置 TARO_APP_API_MODE=auto|http|mock、TARO_APP_API_ORIGIN=http://电脑局域网地址:3000
