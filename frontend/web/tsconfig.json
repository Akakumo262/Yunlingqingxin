{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@yunling/contracts": ["../../contracts/src/core.ts"],
      "@yunling/contracts/mock": ["../../contracts/src/mock/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
